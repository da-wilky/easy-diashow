{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dev server + Chrome",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "debugWithChrome",
        "webRoot": "${workspaceFolder}"
      }
    },
    {
      "name": "Unit tests",
      "type": "node-terminal",
      "request": "launch",
      "command": "npx vitest run ${relativeFile}"
    }
  ]
}
